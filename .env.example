# Protect the Herogod API. Strongly recommended for any public tunnel.
HEROGOD_API_TOKEN=replace-with-a-long-random-string

# Optional providers. Never commit real keys.
# HF_TOKEN may instead be supplied per browser tab in Connection settings.
HF_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image

# Local inference defaults. Leave MAX_IMAGE_SIZE empty for per-model defaults.
HEROGOD_MODEL=timbrooks/instruct-pix2pix
HEROGOD_MAX_IMAGE_SIZE=
HEROGOD_CPU_OFFLOAD=0
HEROGOD_MAX_CONCURRENCY=1

# Optional FLUX 3 official prompt upsampler (substantial extra GPU/RAM).
HEROGOD_FLUX_UPSAMPLING=0
HEROGOD_FLUX_PUP_MODEL=black-forest-labs/flux-3-image-klein-pup

# Server
HOST=0.0.0.0
PORT=8000
