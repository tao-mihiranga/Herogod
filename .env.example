# Herogod configuration. Copy to .env or export these before `python server.py`.

# Protect the API. Required for any public tunnel. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(30))"
HEROGOD_API_TOKEN=

# Use the placeholder engine: no torch, no downloads, instant fake output.
HEROGOD_MOCK=0

# Model sources.
HEROGOD_BASE_MODEL=Qwen/Qwen-Image-Edit-2511
HEROGOD_LORA_REPO=ScottzillaSystems/qwen-image-edit-plus-nsfw-lora
HEROGOD_LORA_WEIGHT=qwen-image-edit-plus-nsfw-lora.safetensors
HEROGOD_LORA_ADAPTER=mcnl-nsfw-v1
HEROGOD_LORA_LABEL=MCNL NSFW v1
# Optional extra adapters: repo:weight:name,repo2:weight2:name2
HEROGOD_EXTRA_LORAS=
# Local snapshot directory (set by scripts/download_models.py).
# Optional local snapshot path, e.g. /content/models/Qwen--Qwen-Image-Edit-2511
HEROGOD_BASE_MODEL_PATH=
HEROGOD_MODELS_DIR=

# HF token for gated/private downloads and faster authenticated pulls.
HF_TOKEN=

# Memory / speed.
# dtype: auto | bf16 | fp16 | fp32   (auto uses bf16 on Ampere+, fp16 on T4, fp32 on CPU)
HEROGOD_DTYPE=auto
# quant: none | bnb4
HEROGOD_QUANT=none
# offload: none | model | sequential
HEROGOD_OFFLOAD=none
HEROGOD_VAE_TILING=1
# Output pixel budget: 1024*1024 = 1024x1024. Lower it if you run out of VRAM.
HEROGOD_MAX_PIXELS=1048576
HEROGOD_MAX_REFS=3

# Generation defaults.
HEROGOD_STEPS=20
HEROGOD_TRUE_CFG=4.0
HEROGOD_LORA_SCALE=1.0

# Server.
HOST=0.0.0.0
PORT=8000
HEROGOD_MAX_CONCURRENCY=1
LOG_LEVEL=INFO
